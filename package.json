{
  "name": "engineer-growth-framework",
  "private": true,
  "version": "8.2.9",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "check-node-version": "node scripts/check-node-version.js",
    "prebuild": "npm run -s check-node-version",
    "dev": "npm run -s prebuild && vite --port=5174",
    "build": "vite build",
    "lint+format:check": "npm run lint:check && npm run format:check",
    "lint+format:fix": "npm run lint:fix && npm run format:fix",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "format:fix": "oxfmt -c .oxfmtrc.json --write .",
    "preview": "vite preview",
    "updateDependencies": "npx npm-check-updates --target minor -u",
    "checkForUpdates": "npx npm-check-updates",
    "checkForUpdates:minor": "npx npm-check-updates --target minor",
    "bumpver:commit": "git add package.json package-lock.json && git commit -m \"v$npm_package_version\"",
    "bumpver:patch": "npm version patch --no-git-tag-version && npm run -s bumpver:commit",
    "bumpver:minor": "npm version minor --no-git-tag-version && npm run -s bumpver:commit",
    "bumpver:major": "npm version major --no-git-tag-version && npm run -s bumpver:commit"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@zumer/snapdom": "^2.24.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "date-fns": "^4.4.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
